# ─────────────────────────────────────────────────────────────────────────────
# KiteFlow — Environment Variables
# Copy this file to .env.local and fill in your values.
# The app runs in demo mode without a private key (X402_DEMO_MODE=true).
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required. Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Kite Chain ────────────────────────────────────────────────────────────────
# Your wallet private key — used to sign chain transactions.
# Export from MetaMask → Account Details → Export Private Key.
# Optional: if missing, chain writes are skipped and the app runs in demo mode.
AGENT_WALLET_PRIVATE_KEY=0x...

# Kite RPC endpoint (testnet by default).
KITE_RPC_URL=https://rpc-testnet.gokite.ai/

# Your deployed WorkflowAttestation contract address.
# Run "npm run deploy:testnet" first, then paste the printed address here.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# Block explorer base URL (shown in the UI for tx links).
KITE_EXPLORER_URL=https://testnet.kitescan.ai

# ── x402 Payment Protocol ─────────────────────────────────────────────────────
# Set to "true" to simulate x402 payments without spending real USDC.
# Set to "false" on mainnet with real funds.
X402_DEMO_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# MAINNET (when you're ready to go live)
# ─────────────────────────────────────────────────────────────────────────────
# KITE_RPC_URL=https://rpc.gokite.ai/
# KITE_EXPLORER_URL=https://kitescan.ai
# X402_DEMO_MODE=false
